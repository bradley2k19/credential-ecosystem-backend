DATABASE_URL=postgresql://user:password@localhost:5432/yourdb
JWT_SECRET=your_jwt_secret_here
# Comma-separated list of frontend origins allowed to call this API from a browser (exact match, no wildcard).
# A single origin also works. Trailing slashes and spaces around commas are ignored.
FRONTEND_URL=http://localhost:3000,https://credential-ecosystem-frontend.vercel.app
BLOCKCHAIN_RPC_URL=https://your-amoy-rpc-url
CONTRACT_ADDRESS=0xYourCertificateRegistryAddress
ADMIN_PRIVATE_KEY=0xYourDeployerPrivateKey
# Only read by `npm run seed:admin`, run manually. Prefer setting these in the shell for that one command
# rather than storing the password here. Never set them on Vercel.
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=at-least-12-characters
