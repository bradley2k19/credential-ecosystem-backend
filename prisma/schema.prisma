generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  INSTITUTION
  STUDENT
  EMPLOYER
  // Platform administrator. No profile table: the User row is the whole account.
  ADMIN
}

enum CertificateStatus {
  ACTIVE
  REVOKED
}

enum TxType {
  ISSUE
  REVOKE
}

enum TxStatus {
  PENDING
  CONFIRMED
  FAILED
}

enum VerificationMethod {
  QR
  MANUAL_ID
}

enum VerificationResult {
  VALID
  REVOKED
  NOT_FOUND
  TAMPERED
  PENDING_CHAIN
}

enum AssetKind {
  LOGO
  SEAL
  SIGNATURE
}

enum CorrectionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum NotificationType {
  CERT_ISSUED
  CERT_REVOKED
  // A certificate was verified (any result linked to a certificate).
  VERIFICATION_REQUEST
  // A student asked for a correction (sent to the institution).
  CORRECTION_REQUEST
  // The institution approved or rejected a correction request (sent to the student).
  CORRECTION_RESOLVED
}

model User {
  id                   String            @id @default(uuid())
  email                String            @unique
  passwordHash         String
  role                 UserRole
  isActive             Boolean           @default(true)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  // Whether this user is notified when one of their certificates is verified (used for students).
  notifyOnVerification Boolean           @default(true)
  institution          Institution?
  student              Student?
  employer             Employer?
  staffProfile         InstitutionStaff?
  notifications        Notification[]
  auditLogs            AuditLog[]
}

model Institution {
  id                 String            @id @default(uuid())
  user               User              @relation(fields: [userId], references: [id])
  userId             String            @unique
  name               String
  registrationNumber String            @unique
  address            String?
  contactEmail       String?
  walletAddress      String?           @unique
  isVerified         Boolean           @default(false)
  createdAt          DateTime          @default(now())
  // #RRGGBB accent colour for certificates.
  brandColor         String?
  logoAssetId        String?
  logoAsset          InstitutionAsset? @relation("InstitutionLogo", fields: [logoAssetId], references: [id])
  sealAssetId        String?
  sealAsset          InstitutionAsset? @relation("InstitutionSeal", fields: [sealAssetId], references: [id])

  staff        InstitutionStaff[]
  students     Student[]
  certificates Certificate[]
  assets       InstitutionAsset[]    @relation("InstitutionAssets")
  signatories  Signatory[]
  templates    CertificateTemplate[]
}

// Design-only certificate layout (no images, URLs or asset ids). Never deleted; archived instead.
model CertificateTemplate {
  id            String      @id @default(uuid())
  institution   Institution @relation(fields: [institutionId], references: [id])
  institutionId String
  name          String
  // Lower-cased, trimmed name: lets the database enforce case-insensitive uniqueness per institution.
  nameKey       String
  design        Json
  isDefault     Boolean     @default(false)
  isArchived    Boolean     @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  certificates Certificate[]

  @@unique([institutionId, nameKey])
  @@index([institutionId, isArchived])
}

// Uploaded images are immutable: never updated or deleted, because issued certificates will reference them.
// Replacing a logo creates a new asset and re-points the institution at it.
model InstitutionAsset {
  id            String      @id @default(uuid())
  institution   Institution @relation("InstitutionAssets", fields: [institutionId], references: [id])
  institutionId String
  kind          AssetKind
  mimeType      String
  sizeBytes     Int
  width         Int
  height        Int
  data          Bytes
  createdAt     DateTime    @default(now())

  logoFor     Institution[] @relation("InstitutionLogo")
  sealFor     Institution[] @relation("InstitutionSeal")
  signatories Signatory[]

  @@index([institutionId])
}

// Archived (isActive false) instead of deleted, so past certificates keep their signatory.
model Signatory {
  id                       String            @id @default(uuid())
  institution              Institution       @relation(fields: [institutionId], references: [id])
  institutionId            String
  name                     String
  title                    String
  signatureAssetId         String?
  signatureAsset           InstitutionAsset? @relation(fields: [signatureAssetId], references: [id])
  displayOrder             Int
  isActive                 Boolean           @default(true)
  authorisationConfirmedAt DateTime?
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt

  @@index([institutionId, isActive])
}

model InstitutionStaff {
  id            String      @id @default(uuid())
  institution   Institution @relation(fields: [institutionId], references: [id])
  institutionId String
  user          User        @relation(fields: [userId], references: [id])
  userId        String      @unique
  fullName      String
  position      String?
  createdAt     DateTime    @default(now())

  resolvedCorrections CredentialCorrectionRequest[] @relation("resolvedBy")
}

model Student {
  id             String      @id @default(uuid())
  user           User        @relation(fields: [userId], references: [id])
  userId         String      @unique
  institution    Institution @relation(fields: [institutionId], references: [id])
  institutionId  String
  fullName       String
  studentNumber  String
  dateOfBirth    DateTime?
  programName    String
  enrollmentYear Int
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  certificates       Certificate[]
  correctionRequests CredentialCorrectionRequest[]

  @@unique([institutionId, studentNumber])
}

model Employer {
  id                 String   @id @default(uuid())
  user               User     @relation(fields: [userId], references: [id])
  userId             String   @unique
  companyName        String
  registrationNumber String?
  industry           String?
  contactEmail       String?
  createdAt          DateTime @default(now())

  verifications CertificateVerification[]
}

model Certificate {
  id                     String               @id @default(uuid())
  certificateUid         String               @unique
  student                Student              @relation(fields: [studentId], references: [id])
  studentId              String
  institution            Institution          @relation(fields: [institutionId], references: [id])
  institutionId          String
  certificateType        String
  programName            String
  classification         String?
  issueDate              DateTime
  graduationDate         DateTime?
  documentUrl            String?
  certificateHash        String
  qrCodeUrl              String?
  status                 CertificateStatus    @default(ACTIVE)
  revokedReason          String?
  revokedAt              DateTime?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  // Frozen at issuance (design + branding + signatories) and never written again. Null for older certificates.
  renderSnapshot         Json?
  templateId             String?
  // Which hash function covers this certificate (src/utils/certificateHash.ts). 1: the original seven inputs.
  // 2: every fact the certificate prints, including the frozen copies below. Never changed after issuance.
  hashVersion            Int                  @default(1)
  // The facts the certificate prints, copied at issuance (hash version 2) and never written again, so later edits
  // to the student or institution never change an issued certificate. Null for version 1 certificates.
  studentNameAtIssue     String?
  studentNumberAtIssue   String?
  institutionNameAtIssue String?
  template               CertificateTemplate? @relation(fields: [templateId], references: [id], onDelete: Restrict)

  blockchainTransactions BlockchainTransaction[]
  verifications          CertificateVerification[]
  correctionRequests     CredentialCorrectionRequest[] @relation("CorrectionRequestCertificate")
  // The correction request this certificate was issued to fix, if any.
  replacementFor         CredentialCorrectionRequest?  @relation("CorrectionReplacement")
  notifications          Notification[]
}

model BlockchainTransaction {
  id            String      @id @default(uuid())
  certificate   Certificate @relation(fields: [certificateId], references: [id])
  certificateId String
  txType        TxType
  txHash        String
  network       String
  blockNumber   Int?
  status        TxStatus    @default(PENDING)
  gasUsed       Int?
  submittedAt   DateTime    @default(now())
  confirmedAt   DateTime?
}

model CertificateVerification {
  id                    String             @id @default(uuid())
  certificate           Certificate?       @relation(fields: [certificateId], references: [id])
  certificateId         String?
  certificateUidQueried String
  employer              Employer?          @relation(fields: [employerId], references: [id])
  employerId            String?
  method                VerificationMethod
  result                VerificationResult
  verifiedAt            DateTime           @default(now())
  ipAddress             String?
}

// A student's request to correct an issued certificate. Certificates never change: an approved request is fixed
// by issuing a replacement certificate (linked here) and then revoking the original.
model CredentialCorrectionRequest {
  id                       String            @id @default(uuid())
  certificate              Certificate       @relation("CorrectionRequestCertificate", fields: [certificateId], references: [id])
  certificateId            String
  student                  Student           @relation(fields: [studentId], references: [id])
  studentId                String
  requestDetails           String
  status                   CorrectionStatus  @default(PENDING)
  // Unused for now (no institution staff accounts yet); who decided is recorded in the audit log.
  resolvedBy               InstitutionStaff? @relation("resolvedBy", fields: [resolvedById], references: [id])
  resolvedById             String?
  requestedAt              DateTime          @default(now())
  resolvedAt               DateTime?
  // The institution's note when deciding (required to reject).
  resolutionNote           String?
  // The certificate issued to fix an approved request. At most one per request, and one request per certificate.
  replacementCertificateId String?           @unique
  replacementCertificate   Certificate?      @relation("CorrectionReplacement", fields: [replacementCertificateId], references: [id])
  notifications            Notification[]

  @@index([certificateId, status])
}

// In-app notifications only (no email or push).
model Notification {
  id                         String                       @id @default(uuid())
  user                       User                         @relation(fields: [userId], references: [id])
  userId                     String
  type                       NotificationType
  message                    String
  relatedCertificate         Certificate?                 @relation(fields: [relatedCertificateId], references: [id])
  relatedCertificateId       String?
  relatedCorrectionRequest   CredentialCorrectionRequest? @relation(fields: [relatedCorrectionRequestId], references: [id])
  relatedCorrectionRequestId String?
  // When set, the same user gets at most one notification with this key per 24 hours.
  dedupeKey                  String?
  isRead                     Boolean                      @default(false)
  createdAt                  DateTime                     @default(now())

  @@index([userId, isRead, createdAt])
  @@index([userId, dedupeKey, createdAt])
}

model AuditLog {
  id         String   @id @default(uuid())
  user       User?    @relation(fields: [userId], references: [id])
  userId     String?
  action     String
  entityType String?
  entityId   String?
  details    Json?
  ipAddress  String?
  createdAt  DateTime @default(now())
}

// One counted request for rate limiting (src/utils/rateLimit.ts). keyHash is an HMAC of the IP address, email or
// user id, so no raw key is ever stored. Events older than a day are deleted opportunistically.
model RateLimitEvent {
  id        String   @id @default(uuid())
  scope     String
  keyHash   String
  createdAt DateTime @default(now())

  @@index([scope, keyHash, createdAt])
}
